{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "dev",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev"
      ],
      "port": 5173
    },
    {
      "name": "dev-lan",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "vite",
        "--host",
        "--port",
        "5173",
        "--strictPort"
      ],
      "port": 5173
    },
    {
      "name": "dev-https",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev:https"
      ],
      "port": 5178,
      "url": "https://localhost:5178"
    },
    {
      "name": "dev-leaderboard",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev:leaderboard"
      ],
      "port": 5174
    },
    {
      "name": "dev-alt",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "vite",
        "--port",
        "5175",
        "--strictPort"
      ],
      "port": 5175
    },
    {
      "name": "preview-build",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "vite",
        "preview",
        "--port",
        "5176",
        "--strictPort"
      ],
      "port": 5176
    }
  ]
}
